{
  "manifest_version": 3,
  "name": "middleshoooot by more",
  "version": "0.5.0",
  "description": "手动滚动拼接聊天长截图，自动清理浮层；支持裁剪、箭头、文字、画笔与隐私遮挡，全程本机处理。",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "middleshoooot by more · 选择区域并长截图",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  }
}
